/tools/pinyin/py_pypinyin.json
/tools/pinyin/py_pinyinpro.json
/tools/pinyin/py_pinyinpro_alt.json
/tools/pinyin/_ref/
/tools/pinyin/_*.txt
/tools/pinyin/_*.log
/tools/pinyin/zdic_words.txt

